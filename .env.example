# ---------------------------------------------------------------------------
# Database
# Leave DATABASE_URL empty for local development: an embedded Postgres (PGlite)
# is stored under DATA_DIR. In production set a real Postgres connection string
# (e.g. Supabase -> Project Settings -> Database -> Connection string, "Session pooler").
# ---------------------------------------------------------------------------
DATABASE_URL=
DATA_DIR=.data

# ---------------------------------------------------------------------------
# Storage driver: "local" (files under DATA_DIR/storage) or "s3" (any S3-compatible
# store, e.g. Supabase Storage S3 endpoint, Cloudflare R2, AWS S3).
# The bucket must be PRIVATE. Visitors receive short-lived signed URLs only for
# assets referenced by the currently published snapshot.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Public project selection: slug of the project served at "/".
# Leave empty to serve the first project created.
# ---------------------------------------------------------------------------
PUBLIC_PROJECT_SLUG=

# Set to "true" only when the site is served over HTTPS (production). Controls the
# Secure flag on the admin session cookie.
SECURE_COOKIES=false
