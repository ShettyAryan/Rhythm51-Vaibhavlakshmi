{
  "name": "property-tour-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "demo:assets": "python scripts/generate-demo-assets.py",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "test": "vitest run",
    "test:e2e": "next build && playwright test",
    "e2e:serve": "tsx scripts/e2e-prepare.ts && next start -p 3100",
    "export:shell": "tsx scripts/build-static-shell.ts",
    "export": "tsx scripts/export-static.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@electric-sql/pglite": "0.5.11",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "esbuild": "^0.28.2",
    "postcss": "^8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
